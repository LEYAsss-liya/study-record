#include <iostream>
#include <vector>
#include <algorithm>
#include <string>

using namespace std;

int main()
{
    int str[10];
    int i, a, j;
    for(i=0; i<10; i++){
        cin >> str[i];
    }
    cin >> a;
    int b=a+30;
    int sum=0;
    for(j=0; j<10; j++){
        if(str[j] <= b){
            sum++;
        }
    }
    cout << sum << endl;



    return 0;
}
