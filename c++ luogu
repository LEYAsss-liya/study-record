#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main()
{
    vector<int>arr;
    int x;
    while(cin >> x){
        if(x==0){
            break;
        }
        else{
            arr.push_back(x);
        }
    }
    reverse(arr.begin(), arr.end());
    for(int i=0; i<arr.size(); i++){
        cout << arr[i] << " ";
    }

    return 0;
}
